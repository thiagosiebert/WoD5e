// 2. Função assíncrona para organizar em subpastas e importar
async function importarComPastas() {
    // Dicionário para traduzir o ID da disciplina
    const nomesDisciplinas = {
        "animalism": "Animalismo",
        "auspex": "Auspícios",
        "dominate": "Dominação",
        "fortitude": "Fortitude",
        "obfuscate": "Ofuscação",
        "presence": "Presença",
        "protean": "Proteanismo",
        "bloodsorcery": "Feitiçaria de Sangue",
        "ritual": "Rituais (Feitiçaria)",
        "oblivion": "Oblívio",
        "ceremony": "Cerimônias (Oblívio)",
        "thinbloodalchemy": "Alquimia Sangue-Ralo"
    };

    // Usaremos um cache rápido para evitar que o Foundry se perca ao criar muitas pastas simultâneas
    let cachePastas = {};

    // 1. Garante a Pasta Raiz Mestre
    const rootName = "Novas Disciplinas";
    let rootFolder = game.folders.find(f => f.name === rootName && f.type === "Item" && (!f.folder || !f.folder.id));
    
    if (!rootFolder) {
        rootFolder = await Folder.create({ name: rootName, type: "Item" });
    }

    for (let itemData of lote) {
        // Pega os dados básicos do poder
        let discKey = itemData.system?.discipline || "Outros";
        let discName = nomesDisciplinas[discKey] || discKey;
        let lvl = itemData.system?.level || 1;
        let lvlName = "Nível " + lvl;

        // 2. Garante a Pasta da Disciplina (ex: "Animalismo") dentro da raiz
        let discFolderId = cachePastas[discName];
        if (!discFolderId) {
            let discFolder = game.folders.find(f => f.name === discName && f.type === "Item" && f.folder?.id === rootFolder.id);
            if (!discFolder) {
                discFolder = await Folder.create({ name: discName, type: "Item", folder: rootFolder.id });
            }
            discFolderId = discFolder.id;
            cachePastas[discName] = discFolderId;
        }

        // 3. Garante a Pasta do Nível (ex: "Nível 1") dentro da Disciplina
        let cacheKeyLvl = `${discName}-${lvlName}`;
        let lvlFolderId = cachePastas[cacheKeyLvl];
        if (!lvlFolderId) {
            let lvlFolder = game.folders.find(f => f.name === lvlName && f.type === "Item" && f.folder?.id === discFolderId);
            if (!lvlFolder) {
                lvlFolder = await Folder.create({ name: lvlName, type: "Item", folder: discFolderId });
            }
            lvlFolderId = lvlFolder.id;
            cachePastas[cacheKeyLvl] = lvlFolderId;
        }

        // 4. Guarda o ID da pasta do nível no próprio item antes de criá-lo
        itemData.folder = lvlFolderId;
    }

    // Finalmente, cria os itens todos nos lugares certos
    await Item.createDocuments(lote);
    ui.notifications.info("Itens importados com sucesso em " + rootName + "!");
}

importarComPastas();