async function criarEscudo() {
  // Verifica se os dados foram inseridos
  if (!escudoData || escudoData.length === 0) {
    ui.notifications.warn("Aviso: A variável escudoData está vazia. Cole o conteúdo do JSON nela.");
    return;
  }

  ui.notifications.info("Iniciando a criação do Escudo do Narrador...");

  try {
    // 1. Cria uma pasta para manter os diários organizados
    let folder = await Folder.create({ 
      name: "Escudo do Narrador V5", 
      type: "JournalEntry",
      color: "#a81e18" // Um tom de vermelho escuro temático
    });

    // 2. Itera sobre os blocos de dados para criar os diários
    for (let entry of escudoData) {
      
      // Mapeia as páginas para o formato de documento do Foundry (HTML)
      let paginasFormatadas = entry.paginas.map(p => ({
        name: p.nome,
        type: "text",
        text: { 
          content: p.conteudo, 
          format: 1 // 1 indica que o conteúdo é HTML
        } 
      }));

      // Cria o Journal Entry na pasta criada
      await JournalEntry.create({
        name: entry.titulo,
        folder: folder.id,
        pages: paginasFormatadas
      });
    }
    
    ui.notifications.info("Escudo do Narrador importado com sucesso! Verifique sua aba de Diários.");
    
  } catch (error) {
    console.error("Erro ao criar os diários:", error);
    ui.notifications.error("Ocorreu um erro. Verifique o console (F12) para mais detalhes.");
  }
}

// Executa a função
criarEscudo();